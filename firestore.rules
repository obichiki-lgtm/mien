rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 学習スケジューラー（ルートの index.html）
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // Pomo Timer（pomo/index.html）: 各ユーザーは自分の pomo/{uid}/docs/* だけ読み書きできる
    match /pomo/{uid}/docs/{doc} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // ご意見・要望（Pomo Timer の送信フォーム）: 誰でも作成だけできる。読み取り・変更・削除は不可
    // （GitHub Actions がサービスアカウントで読み、GitHub Issue に転記する）
    match /feedback/{id} {
      allow create: if request.resource.data.keys().hasOnly(['text', 'kind', 'page', 'ua', 'at', 'uid', 'processed'])
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 2000
        && request.resource.data.kind in ['idea', 'bug', 'other']
        && request.resource.data.page is string && request.resource.data.page.size() <= 20
        && request.resource.data.ua is string && request.resource.data.ua.size() <= 300
        && request.resource.data.at == request.time
        && request.resource.data.processed == false
        && (request.resource.data.uid == null
            || (request.auth != null && request.resource.data.uid == request.auth.uid));
    }
  }
}
